<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Solo por System.Windows.Automation (UI Automation); no hay XAML. -->
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Colo</AssemblyName>
    <Product>Colo</Product>
    <Version>1.28.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>colo.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>es;pt</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="settings.html" LogicalName="Colo.settings.html" />
    <EmbeddedResource Include="stage.html" LogicalName="Colo.stage.html" />
    <!-- Whisper (whisper.cpp) para Windows dentro del .exe; se extraen a %LOCALAPPDATA%\Colo\native al arrancar. -->
    <EmbeddedResource Include="$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))whisper.net.runtime/1.9.1/build/win-x64/*.dll" LogicalName="whisper/%(Filename)%(Extension)" />
    <!-- sherpa-onnx (voces de las reuniones), igual: dentro del .exe y se extraen la primera vez que hacen falta. -->
    <EmbeddedResource Include="$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))org.k2fsa.sherpa.onnx.runtime.win-x64/2.0.1/runtimes/win-x64/native/*.dll" LogicalName="sherpa/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Sin la carpeta runtimes/ al lado del .exe: todo va embebido. -->
  <Target Name="NoWhisperRuntimeFolder" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)" Condition="$([System.String]::Copy('%(None.FullPath)').Contains('whisper.net.runtime'))" />
    </ItemGroup>
  </Target>
  <!-- Y sin copiarlas sueltas (irían también al paquete de arranque, extraídas en cada versión). -->
  <Target Name="NoSherpaNativeCopy" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.String]::Copy('%(NativeCopyLocalItems.Identity)').Contains('sherpa.onnx.runtime'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.Identity)').Contains('sherpa.onnx.runtime'))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Preview" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Colo.Core\Colo.Core.csproj" />
  </ItemGroup>
</Project>

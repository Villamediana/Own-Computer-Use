<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Solo por System.Windows.Automation (UI Automation); no hay XAML. -->
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Colo</AssemblyName>
    <Product>Colo</Product>
    <Version>1.2.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>colo.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>es;pt</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="settings.html" LogicalName="Colo.settings.html" />
    <!-- Whisper (whisper.cpp) para Windows dentro del .exe; se extraen a %LOCALAPPDATA%\Colo\native al arrancar. -->
    <EmbeddedResource Include="$(NuGetPackageRoot)whisper.net.runtime/1.9.1/build/win-x64/*.dll" LogicalName="whisper/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Sin la carpeta runtimes/ al lado del .exe: todo va embebido. -->
  <Target Name="NoWhisperRuntimeFolder" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)" Condition="$([System.String]::Copy('%(None.FullPath)').Contains('whisper.net.runtime'))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Preview" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Colo.Core\Colo.Core.csproj" />
  </ItemGroup>
</Project>
